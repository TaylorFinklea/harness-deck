{{define "shell" -}}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>harness-deck</title>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#161723" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="harness-deck" />
<script>
  // Apply the saved theme preference before the page renders so we don't
  // flash dark/light incorrectly. "system" (or absent) defers to the
  // prefers-color-scheme media query in tokyo-night.css.
  (function(){
    try {
      var t = localStorage.getItem('harness-deck:theme');
      if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
    } catch(_) {}
  })();
</script>
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="icon" href="{{.Favicon}}" />
<link rel="apple-touch-icon" href="/icon-180.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
<style>{{.CSS}}</style>
</head>
<body>

<header class="term-chrome">
  <div class="titlebar">
    <button class="menu-button" type="button" aria-label="Toggle navigation">☰</button>
    <div class="dots"><span></span><span></span><span></span></div>
    <div class="title"><b>harness-deck</b> · dashboard<span id="title-asks" class="title-asks"></span></div>
    <button id="titlebar-settings" class="title-search-btn" type="button" aria-label="Settings" title="settings">⚙</button>
    <button class="title-search-btn" type="button" aria-label="Search reports" onclick="HDSearch && HDSearch.open()">?</button>
    <div class="clock" id="clock">--:--:--</div>
  </div>
  <div class="keyhints vim-no-search">
    <span><kbd>j</kbd><kbd>k</kbd> row</span>
    <span><kbd>Enter</kbd> open</span>
    <span><kbd>p</kbd> pin</span>
    <span><kbd>a</kbd> archive</span>
    <span><kbd>x</kbd> close</span>
    <span><kbd>Space e</kbd> tree</span>
    <span><kbd>⌘K</kbd> search</span>
    <span><kbd>?</kbd> help</span>
  </div>
</header>

<div class="drawer-scrim"></div>
<div class="layout">
  <aside class="sidebar vim-no-search" id="tree"></aside>
  <main class="content" id="content">
    <div class="empty">loading reports…</div>
  </main>
</div>

<div class="statusline" id="status" data-vim-mode="NORMAL">
  <span class="seg mode" id="mode">▌ NORMAL</span>
  <span class="seg file">dashboard</span>
  <span class="seg info">harness-deck</span>
  <span class="spacer"></span>
  <span class="seg usage" id="usage"></span>
  <span class="seg pos">{{.Addr}}</span>
</div>

<script>window.HD_BEADS = {{.BeadsEnabled}};</script>
<script>{{.HDDomJS}}</script>
<script>{{.VimJS}}</script>
<script>{{.AppJS}}</script>
<script>{{.MobileJS}}</script>
<script>{{.TabsJS}}</script>
<script>{{.SavedJS}}</script>
<script>{{.SearchJS}}</script>
<script>{{.UsageJS}}</script>
<script>
  setInterval(() => {
    const d = new Date(), p = (n) => String(n).padStart(2, '0');
    document.getElementById('clock').textContent = p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds());
  }, 1000);
  const modeEl = document.getElementById('mode');
  VimNav.init({ statusEl: '#status', onMode: (m) => { modeEl.textContent = '▌ ' + m; } });
</script>
</body>
</html>
{{- end}}
