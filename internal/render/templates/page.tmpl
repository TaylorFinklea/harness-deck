{{define "page" -}}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>harness-deck · {{.Report.Title}}</title>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#161723" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="harness-deck" />
<script>
  // Apply the saved theme preference before the page renders so we don't
  // flash dark/light incorrectly. "system" (or absent) defers to the
  // prefers-color-scheme media query in tokyo-night.css.
  (function(){
    try {
      var t = localStorage.getItem('harness-deck:theme');
      if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
    } catch(_) {}
  })();
</script>
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="icon" href="{{.Favicon}}" />
<link rel="apple-touch-icon" href="/icon-180.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
<style>{{.CSS}}</style>
</head>
<body>

<header class="term-chrome">
  <div class="titlebar">
    <button class="menu-button" type="button" aria-label="Toggle navigation">☰</button>
    <div class="dots"><span></span><span></span><span></span></div>
    <div class="title"><b>harness-deck</b> · {{.Report.Project}} · agent {{with .Report.Agent}}{{.}}{{else}}{{$.Report.Harness}}{{end}}</div>
    <div class="clock" id="clock">--:--:--</div>
  </div>
  <div class="tabbar">
    <div class="tab active"><span class="num">1</span> {{.Report.Title}}</div>
    <div class="report-actions vim-no-search">
      {{if eq .Report.Status "done"}}
        <button onclick="hdReopen()" title="reopen (back to inbox)">↺ reopen</button>
      {{else}}
        <button onclick="hdClose()" title="close (mark done)">✕ close</button>
      {{end}}
      {{if .Report.Archived}}
        <button onclick="hdUnarchive()" title="restore from archive">↺ unarchive</button>
      {{else}}
        <button onclick="hdArchive()" title="hide from default views (recoverable)">📦 archive</button>
      {{end}}
      <button onclick="hdDelete()" class="danger" title="delete the report file (permanent)">⌦ delete</button>
    </div>
  </div>
  <div class="keyhints vim-no-search">
    <span><kbd>j</kbd><kbd>k</kbd> scroll</span>
    <span><kbd>]</kbd><kbd>[</kbd> section</span>
    <span><kbd>Tab</kbd> next ask</span>
    <span><kbd>1</kbd>–<kbd>9</kbd> answer</span>
    <span><kbd>y</kbd><kbd>n</kbd> yes/no</span>
    <span><kbd>/</kbd> search</span>
    <span><kbd>:</kbd> command</span>
    <span><kbd>?</kbd> help</span>
  </div>
</header>

<div class="drawer-scrim"></div>
<div class="layout">
  <aside class="sidebar vim-no-search">
    <div class="sidebar-section">
      <div class="sidebar-title">contents</div>
      <ol class="toc">
        {{range .TOC}}<li onclick="location.hash='{{.Anchor}}'"><span class="n">{{.Num}}</span><span class="dots">{{.Title}} ·······································</span><span class="pg">§</span></li>
        {{end}}
      </ol>
    </div>
    <div class="sidebar-section">
      <div class="sidebar-title">run</div>
      <div style="font-size:11px; line-height:1.7; color: var(--tn-fg-dark);">
        {{range .Run}}<div><span style="color:var(--tn-comment)">{{.Key}}</span> <span style="color:var(--tn-cyan)">{{.Value}}</span></div>
        {{end}}
      </div>
    </div>
  </aside>

  <main class="content">
    <div class="report-banner" data-vim-section data-vim-heading id="sec-banner">
      <div>
        {{with .Banner.Kicker}}<div class="kicker">{{.}}</div>{{end}}
        <h1>{{with .Banner.Scope}}<span class="scope">{{.}}</span> {{end}}{{.Banner.Title}}</h1>
      </div>
      <div class="meta">
        {{range .Banner.Meta}}<div><b>{{.Key}}</b> {{.Value}}</div>
        {{end}}
      </div>
    </div>

    {{if .OpenAsks}}
    <div class="open-asks" id="open-asks">
      <div class="open-asks-head">
        <span class="open-asks-count">{{len .OpenAsks}} unanswered</span>
        <span class="open-asks-hint">tap to jump</span>
      </div>
      <ul class="open-asks-list">
        {{range .OpenAsks}}<li><a href="#{{.Anchor}}"><span class="num">§{{.Num}}</span> <span class="kind {{.Kind}}">{{.Kind}}</span> <span class="title">{{.Title}}</span></a></li>{{end}}
      </ul>
    </div>
    {{end}}

    {{range .Blocks}}{{.}}
    {{end}}
  </main>
</div>

<div class="statusline" id="status" data-vim-mode="NORMAL">
  <span class="seg mode" id="mode">▌ NORMAL</span>
  <span class="seg file">{{.Report.ID}}</span>
  <span class="seg info">{{.Report.Status}}</span>
  <span class="spacer"></span>
  <span class="seg info"><span id="pct">0%</span></span>
  <span class="seg pos">ln <span id="ln">1</span>:<span id="col">1</span></span>
</div>

<script>window.HD_REPORT = { project: {{.Report.Project}}, run: {{.Report.ID}}, title: {{.Report.Title}}, sig: {{.Sig}} };</script>
<script>
  /* close / reopen / delete — POST then bounce to the dashboard. */
  function hdAction(action, method) {
    var base = '/r/' + encodeURIComponent(HD_REPORT.project) + '/' + encodeURIComponent(HD_REPORT.run);
    fetch(action ? base + '/' + action : base, { method: method }).then(function (r) {
      if (!r.ok) throw new Error('HTTP ' + r.status);
      window.location.href = '/';
    }).catch(function (err) {
      console.error('harness-deck:', err);
      alert('Action failed: ' + err.message);
    });
  }
  function hdClose()     { hdAction('close',     'POST'); }
  function hdReopen()    { hdAction('reopen',    'POST'); }
  function hdArchive()   { hdAction('archive',   'POST'); }
  function hdUnarchive() { hdAction('unarchive', 'POST'); }
  function hdDelete() {
    if (!confirm('Permanently delete this report? This removes the run directory from disk. Archive instead if you might want it back.')) return;
    hdAction('', 'DELETE');
  }
</script>
<script>{{.JS}}</script>
<script>
  setInterval(() => {
    const d = new Date(), p = (n) => String(n).padStart(2, '0');
    document.getElementById('clock').textContent = p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds());
  }, 1000);
  const ln = document.getElementById('ln'), pct = document.getElementById('pct'), modeEl = document.getElementById('mode');
  const updatePos = () => {
    const s = document.scrollingElement;
    const p = s.scrollHeight > s.clientHeight ? Math.round(s.scrollTop / (s.scrollHeight - s.clientHeight) * 100) : 0;
    pct.textContent = p + '%';
    ln.textContent = String(Math.round(s.scrollTop / 22) + 1);
  };
  document.addEventListener('scroll', updatePos, { passive: true });
  updatePos();
  VimNav.init({ statusEl: '#status', onMode: (m) => { modeEl.textContent = '▌ ' + m; } });
  // Pin the report we just landed on into the tab strip (covers direct
  // bookmarks, push-notification deep-links, and browser back/forward).
  if (window.HDTabs) {
    HDTabs.ensureCurrent(HD_REPORT.title || HD_REPORT.run);
    HDTabs.render();
  }
</script>
</body>
</html>
{{- end}}
