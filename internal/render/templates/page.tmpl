{{define "page" -}}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>harness-deck · {{.Report.Title}}</title>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#161723" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="harness-deck" />
<script>
  // Apply the saved theme preference before the page renders so we don't
  // flash dark/light incorrectly. "system" (or absent) defers to the
  // prefers-color-scheme media query in tokyo-night.css.
  (function(){
    try {
      var t = localStorage.getItem('harness-deck:theme');
      if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
    } catch(_) {}
  })();
</script>
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="icon" href="{{.Favicon}}" />
<link rel="apple-touch-icon" href="/icon-180.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
<style>{{.CSS}}</style>
</head>
<body>

<header class="term-chrome">
  <div class="titlebar">
    <button class="menu-button" type="button" aria-label="Toggle navigation">☰</button>
    <div class="dots"><span></span><span></span><span></span></div>
    <div class="title"><b>harness-deck</b> · {{.Report.Project}} · agent {{with .Report.Agent}}{{.}}{{else}}{{$.Report.Harness}}{{end}}</div>
    <div class="clock" id="clock">--:--:--</div>
  </div>
  <div class="actionbar">
    <div class="actionbar-title vim-no-search">{{.Report.Title}}</div>
    <div class="report-actions vim-no-search">
      <button id="hd-pin-btn" type="button" title="pin to sidebar (p)" data-pinned="false">📌 pin<span class="hd-hint">p</span></button>
      {{if eq .Report.Status "done"}}
        <button onclick="hdReopen()" title="reopen (back to inbox)">↺ reopen<span class="hd-hint">r</span></button>
      {{else}}
        <button onclick="hdClose()" title="close (mark done)">✕ close<span class="hd-hint">x</span></button>
      {{end}}
      {{if .Report.Archived}}
        <button onclick="hdUnarchive()" title="restore from archive">↺ unarchive<span class="hd-hint">a</span></button>
      {{else}}
        <button onclick="hdArchive()" title="hide from default views (recoverable)">📦 archive<span class="hd-hint">a</span></button>
      {{end}}
      <button onclick="hdDelete()" class="danger" title="delete the report file (permanent)">⌦ delete<span class="hd-hint">dd</span></button>
    </div>
  </div>
  <div class="keyhints vim-no-search">
    <span><kbd>j</kbd><kbd>k</kbd> scroll</span>
    <span><kbd>]</kbd><kbd>[</kbd> section</span>
    <span><kbd>Tab</kbd> next ask</span>
    <span><kbd>1</kbd>–<kbd>9</kbd> answer</span>
    <span><kbd>y</kbd><kbd>n</kbd> yes/no</span>
    <span><kbd>/</kbd> search</span>
    <span><kbd>:</kbd> command</span>
    <span><kbd>?</kbd> help</span>
  </div>
</header>

<div class="drawer-scrim"></div>
<div class="layout">
  <aside class="sidebar vim-no-search">
    <div class="sidebar-section">
      <div class="sidebar-title">contents</div>
      <ol class="toc">
        {{range .TOC}}<li onclick="location.hash='{{.Anchor}}'"><span class="n">{{.Num}}</span><span class="dots">{{.Title}} ·······································</span><span class="pg">§</span></li>
        {{end}}
      </ol>
    </div>
    <div class="sidebar-section">
      <div class="sidebar-title">run</div>
      <div style="font-size:11px; line-height:1.7; color: var(--tn-fg-dark);">
        {{range .Run}}<div><span style="color:var(--tn-comment)">{{.Key}}</span> <span style="color:var(--tn-cyan)">{{.Value}}</span></div>
        {{end}}
      </div>
    </div>
  </aside>

  <main class="content">
    <div class="report-banner" data-vim-section data-vim-heading id="sec-banner">
      <div>
        {{with .Banner.Kicker}}<div class="kicker">{{.}}</div>{{end}}
        <h1>{{with .Banner.Scope}}<span class="scope">{{.}}</span> {{end}}{{.Banner.Title}}</h1>
        {{if .Tags}}<div class="report-tags">{{range .Tags}}<span class="report-tag">{{.}}</span>{{end}}</div>{{end}}
      </div>
      <div class="meta">
        {{range .Banner.Meta}}<div><b>{{.Key}}</b> {{.Value}}</div>
        {{end}}
      </div>
    </div>

    {{if .Related}}<div class="related-panel" data-vim-section><div class="related-head">related</div>{{range .Related}}<a class="related-link" href="{{.URL}}">{{with .Rel}}<span class="related-rel">{{.}}</span> {{end}}{{.Label}}</a>{{end}}</div>{{end}}

    {{if .Live}}
    <div class="live-banner" id="live-banner" data-updated="{{.Live.Updated}}">
      <div class="live-pulse" aria-hidden="true"></div>
      <div class="live-body">
        <div class="live-head">
          <span class="live-state" data-live-state>working</span>
          {{with .Live.Step}}<span class="live-step">· {{.}}</span>{{end}}
        </div>
        <div class="live-stats">
          {{if .Live.ElapsedMs}}<span class="live-stat" data-live-elapsed="{{.Live.ElapsedMs}}">elapsed —</span>{{end}}
          {{if .Live.Tokens}}<span class="live-stat">tokens <b>{{.Live.Tokens}}</b></span>{{end}}
          {{with .Live.CostUSD}}<span class="live-stat">cost <b>{{.}}</b></span>{{end}}
          {{if .Live.Progress}}<span class="live-stat live-progress" data-live-progress="{{.Live.Progress}}"><span class="bar"><span class="fill"></span></span></span>{{end}}
          <span class="live-stat live-since" data-live-since>just now</span>
        </div>
      </div>
    </div>
    {{end}}

    {{if .OpenAsks}}
    <div class="open-asks" id="open-asks">
      <div class="open-asks-head">
        <span class="open-asks-count">{{len .OpenAsks}} unanswered</span>
        <span class="open-asks-hint">tap to jump</span>
      </div>
      <ul class="open-asks-list">
        {{range .OpenAsks}}<li><a href="#{{.Anchor}}"><span class="num">§{{.Num}}</span> <span class="kind {{.Kind}}">{{.Kind}}</span> <span class="title">{{.Title}}</span></a></li>{{end}}
      </ul>
    </div>
    {{end}}

    {{range .Blocks}}{{.}}
    {{end}}
  </main>
</div>

<div class="statusline" id="status" data-vim-mode="NORMAL">
  <span class="seg mode" id="mode">▌ NORMAL</span>
  <span class="seg file">{{.Report.ID}}</span>
  <span class="seg info">{{.Report.Status}}</span>
  <span class="spacer"></span>
  <span class="seg info"><span id="pct">0%</span></span>
  <span class="seg pos">ln <span id="ln">1</span>:<span id="col">1</span></span>
</div>

<script>window.HD_REPORT = { project: {{.Report.Project}}, run: {{.Report.ID}}, title: {{.Report.Title}}, sig: {{.Sig}} };</script>
<script>
  /* close / reopen / delete — POST then bounce to the dashboard. */
  function hdAction(action, method) {
    var base = '/r/' + encodeURIComponent(HD_REPORT.project) + '/' + encodeURIComponent(HD_REPORT.run);
    fetch(action ? base + '/' + action : base, { method: method }).then(function (r) {
      if (!r.ok) throw new Error('HTTP ' + r.status);
      window.location.href = '/';
    }).catch(function (err) {
      console.error('harness-deck:', err);
      alert('Action failed: ' + err.message);
    });
  }
  function hdClose()     { hdAction('close',     'POST'); }
  function hdReopen()    { hdAction('reopen',    'POST'); }
  function hdArchive()   { hdAction('archive',   'POST'); }
  function hdUnarchive() { hdAction('unarchive', 'POST'); }
  function hdDelete() {
    if (!confirm('Permanently delete this report? This removes the run directory from disk. Archive instead if you might want it back.')) return;
    hdAction('', 'DELETE');
  }

  /* Keyboard bindings for the report-level action buttons. Mirror the
     inbox row actions (x close, a archive, dd delete) so muscle memory
     transfers in both directions. Single-letter; the chord prefix is
     reserved for navigation. */
  (function () {
    var ddArmed = 0;
    document.addEventListener('keydown', function (e) {
      var t = e.target;
      if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
      if (window.VimNav && VimNav.getMode && VimNav.getMode() !== 'NORMAL') return;
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      // Defer to triage when the user is mid-ask: y/n/digits/h/l own
      // the keys then, and a stray x/a here would be jarring.
      if (document.querySelector('.panel.ask-focused')) return;
      var done = {{if eq .Report.Status "done"}}true{{else}}false{{end}};
      var archived = {{if .Report.Archived}}true{{else}}false{{end}};
      switch (e.key) {
        case 'x':
          if (!done) { hdClose(); e.preventDefault(); }
          return;
        case 'r':
          if (done) { hdReopen(); e.preventDefault(); }
          return;
        case 'a':
          if (archived) hdUnarchive(); else hdArchive();
          e.preventDefault();
          return;
        case 'd':
          if (Date.now() - ddArmed < 500) {
            ddArmed = 0;
            hdDelete();
          } else {
            ddArmed = Date.now();
          }
          e.preventDefault();
          return;
      }
    });
  })();
</script>
<script>{{.JS}}</script>
<script>
  setInterval(() => {
    const d = new Date(), p = (n) => String(n).padStart(2, '0');
    document.getElementById('clock').textContent = p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds());
  }, 1000);
  const ln = document.getElementById('ln'), pct = document.getElementById('pct'), modeEl = document.getElementById('mode');
  const updatePos = () => {
    const s = document.scrollingElement;
    const p = s.scrollHeight > s.clientHeight ? Math.round(s.scrollTop / (s.scrollHeight - s.clientHeight) * 100) : 0;
    pct.textContent = p + '%';
    ln.textContent = String(Math.round(s.scrollTop / 22) + 1);
  };
  document.addEventListener('scroll', updatePos, { passive: true });
  updatePos();
  VimNav.init({ statusEl: '#status', onMode: (m) => { modeEl.textContent = '▌ ' + m; } });
  // Reflect the current pin state on the pin button (📌 / ★).
  if (window.HDPins) {
    var pinBtn = document.getElementById('hd-pin-btn');
    var refreshPinBtn = function () {
      if (!pinBtn) return;
      var on = HDPins.isPinned(HD_REPORT.project, HD_REPORT.run);
      pinBtn.dataset.pinned = on ? 'true' : 'false';
      pinBtn.replaceChildren(
        document.createTextNode(on ? '★ pinned' : '📌 pin'),
        Object.assign(document.createElement('span'), { className: 'hd-hint', textContent: 'p' })
      );
    };
    refreshPinBtn();
    // tabs.js fires the 'hd:pins-changed' event after every pin mutation (the
    // `p` key path goes through it). Listen so the pin button stays in sync
    // when `p` toggles, not just on button click. (A DOM event, not the old
    // single-slot window.HDPinsChanged, so the dashboard and the report page
    // can both react.)
    window.addEventListener('hd:pins-changed', refreshPinBtn);
    pinBtn && pinBtn.addEventListener('click', function () {
      HDPins.toggle(HD_REPORT.project, HD_REPORT.run, HD_REPORT.title || HD_REPORT.run);
    });
  }
</script>
</body>
</html>
{{- end}}
