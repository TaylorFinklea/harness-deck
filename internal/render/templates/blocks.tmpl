{{/* Block panel templates. Each receives a render.blockView:
     .Num .ID .Title .Pills .Body  — .Body is the concrete *manifest.XxxBlock. */}}

{{define "panel-head" -}}
<div class="panel-head"><span class="sigil">§</span><span class="num">{{.Num}}</span> <span class="title-text">{{.Title}}</span>
{{- if .Pills}}<div class="right">{{range .Pills}}<span class="pill {{.Level}}">{{.Text}}</span> {{end}}</div>{{end -}}
</div>
{{- end}}

{{define "pills" -}}
{{range .}}<span class="pill {{.Level}}">{{.Text}}</span> {{end}}
{{- end}}

{{define "bars" -}}
<div class="barchart">
{{range .}}<div class="row"><span class="lbl">{{.Label}}</span><div class="bar"><i style="width: {{pct .Pct}}%{{if .Color}}; background: var(--tn-{{.Color}}){{end}}"></i></div><span class="val">{{pct .Pct}}%</span></div>
{{end}}</div>
{{- end}}

{{define "callout-inner" -}}
<div class="callout {{if ne .Level "warn"}}{{.Level}}{{end}}"><span class="tag">[{{if .Tag}}{{.Tag}}{{else}}{{upper .Level}}{{end}}]</span> {{mdInline .Markdown}}</div>
{{- end}}

{{define "block-prose" -}}
<section class="panel" data-vim-section id="{{.ID}}">
{{template "panel-head" .}}
<div class="panel-body prose">{{md .Body.Markdown}}</div>
</section>
{{- end}}

{{define "block-metrics" -}}
<section class="panel" data-vim-section id="{{.ID}}">
{{template "panel-head" .}}
<div class="metric-grid">
{{range .Body.Metrics}}<div class="metric">
<div class="label">{{.Label}}</div>
<div class="value"{{if .Color}} style="color: var(--tn-{{.Color}})"{{end}}>{{.Value}}{{if .Unit}} <span class="unit">{{.Unit}}</span>{{end}}</div>
{{if .Delta}}<div class="delta {{.Trend}}">{{.Delta}}</div>{{end}}
{{if .Spark}}<svg class="spark" viewBox="0 0 80 16" preserveAspectRatio="none"><path d="{{sparkPath .Spark}}" stroke="var(--tn-{{if .Color}}{{.Color}}{{else if eq .Trend "pos"}}green{{else if eq .Trend "neg"}}red{{else}}blue{{end}})"/></svg>{{end}}
</div>
{{end}}</div>
{{if .Body.Bars}}<div class="panel-body tight" style="border-top:1px solid var(--tn-bg-highlight)">{{template "bars" .Body.Bars}}</div>{{end}}
</section>
{{- end}}

{{define "block-risks" -}}
<section class="panel" data-vim-section id="{{.ID}}">
<div class="panel-head"><span class="sigil">§</span><span class="num">{{.Num}}</span> <span class="title-text">{{.Title}}</span>
<div class="right">
{{- $rs := .Body.Risks -}}
{{if riskCount $rs "crit"}}<span class="pill err">{{riskCount $rs "crit"}} crit</span> {{end}}
{{- if riskCount $rs "high"}}<span class="pill warn">{{riskCount $rs "high"}} high</span> {{end}}
{{- $lo := add (riskCount $rs "med") (riskCount $rs "low")}}{{if $lo}}<span class="pill">{{$lo}} low/med</span> {{end}}
{{- template "pills" .Pills}}</div>
</div>
<div class="panel-body">
{{range .Body.Risks}}<div class="pbar">
<div class="lbl"><span class="sev {{.Severity}}">{{upper .Severity}}</span>{{.Label}}</div>
<div class="ascii">{{$ab := asciiBar .Pct}}<span class="{{if eq .Severity "crit"}}crit{{else if eq .Severity "high"}}filled{{else if eq .Severity "med"}}med{{else}}low{{end}}">{{$ab.Filled}}</span><span style="opacity:.4">{{$ab.Empty}}</span></div>
<div class="pct">{{pct .Pct}}%</div>
</div>
{{end}}
{{range .Body.Callouts}}{{template "callout-inner" .}}
{{end}}
</div>
</section>
{{- end}}

{{define "block-diff" -}}
<section class="panel" data-vim-section id="{{.ID}}">
<div class="panel-head"><span class="sigil">§</span><span class="num">{{.Num}}</span> <span class="title-text">{{.Title}}</span>
{{- $d := diffStat .Body}}<div class="right"><span class="pill ok">+ {{$d.Added}}</span> <span class="pill err">− {{$d.Removed}}</span> <span class="pill">{{$d.Files}} files</span> {{template "pills" .Pills}}</div>
</div>
<div class="panel-body" style="padding-top:0">
{{range .Body.Files}}<div class="diff" style="margin-top: 12px">
<div class="file">{{.Path}}{{if .Lang}} <span class="lang">[{{.Lang}}]</span>{{end}}</div>
<pre>{{range .Lines}}<span class="line {{.Kind}}"><span class="ln">{{if eq .Kind "add"}}{{.New}}{{else if eq .Kind "del"}}{{.Old}}{{else if eq .Kind "ctx"}}{{or .New .Old}}{{end}}</span><span class="sig">{{if eq .Kind "add"}}+{{else if eq .Kind "del"}}-{{else if eq .Kind "hunk"}}@@{{else}} {{end}}</span><span class="body">{{.Text}}</span></span>{{end}}</pre>
</div>
{{end}}
</div>
</section>
{{- end}}

{{define "block-timeline" -}}
<section class="panel" data-vim-section id="{{.ID}}">
{{template "panel-head" .}}
<div class="panel-body">
<div class="timeline">
{{range $i, $e := .Body.Events}}<div class="row"><span class="t">{{$e.Time}}</span><span class="b {{$e.Kind}}">{{glyph $i (len $.Body.Events) $e.Kind}}</span><span class="msg">{{mdInline $e.Markdown}}</span></div>
{{end}}</div>
</div>
</section>
{{- end}}

{{define "block-compare" -}}
<section class="panel" data-vim-section id="{{.ID}}">
{{template "panel-head" .}}
<div class="compare">
<div class="a"><h4><span class="tag">{{.Body.A.Tag}}</span> {{.Body.A.Title}}</h4><ul>{{range .Body.A.Items}}<li class="{{.Kind}}">{{.Text}}</li>{{end}}</ul></div>
<div class="b"><h4><span class="tag">{{.Body.B.Tag}}</span> {{.Body.B.Title}}</h4><ul>{{range .Body.B.Items}}<li class="{{.Kind}}">{{.Text}}</li>{{end}}</ul></div>
</div>
</section>
{{- end}}

{{define "block-recommendations" -}}
<section class="panel" data-vim-section id="{{.ID}}">
{{template "panel-head" .}}
<div class="panel-body recs">
{{range $i, $r := .Body.Items}}<div class="rec"><span class="id">{{if $r.ID}}{{$r.ID}}{{else}}#{{add $i 1}}{{end}}</span>{{if $r.Owner}}<span class="own {{$r.Owner}}">{{$r.Owner}}</span>{{else}}<span></span>{{end}}<div class="rec-body">{{md $r.Markdown}}</div></div>
{{end}}</div>
</section>
{{- end}}

{{define "block-callout" -}}
<div class="callout {{if ne .Body.Level "warn"}}{{.Body.Level}}{{end}}" data-vim-section id="{{.ID}}" style="margin-bottom:16px"><span class="tag">[{{if .Body.Tag}}{{.Body.Tag}}{{else}}{{upper .Body.Level}}{{end}}]</span> {{mdInline .Body.Markdown}}</div>
{{- end}}

{{define "block-barchart" -}}
<section class="panel" data-vim-section id="{{.ID}}">
{{template "panel-head" .}}
<div class="panel-body">{{template "bars" .Body.Bars}}</div>
</section>
{{- end}}

{{define "block-table" -}}
<section class="panel" data-vim-section id="{{.ID}}">
{{template "panel-head" .}}
<div class="panel-body" style="padding:0">
<table class="dtable">
<thead><tr>{{range .Body.Columns}}<th>{{.}}</th>{{end}}</tr></thead>
<tbody>{{range .Body.Rows}}<tr>{{range .}}<td>{{mdInline .}}</td>{{end}}</tr>
{{end}}</tbody>
</table>
</div>
</section>
{{- end}}

{{define "block-html" -}}
<section class="panel" data-vim-section id="{{.ID}}">
{{template "panel-head" .}}
<div class="panel-body">{{safeHTML .Body.HTML}}</div>
</section>
{{- end}}

{{define "block-ask" -}}
<section class="panel" data-vim-section id="{{.ID}}">
{{template "panel-head" .}}
<div class="panel-body">
<div class="ask-prompt">{{md .Body.Prompt}}</div>
{{if .Answer -}}
<div class="ask-answered">▸ answered <b>{{.Answer.Value}}</b>{{with .Answer.At}} · {{.}}{{end}}</div>
{{- else -}}
{{$id := .Body.ID}}{{$mode := .Body.ResolvedMode}}
<div class="ask-controls">
{{if eq $mode "choice"}}{{range $i, $opt := .Body.Options}}<button class="hd-btn hd-respond" data-block="{{$id}}" data-value="{{$opt}}">{{$opt}}<span class="hd-hint">{{add $i 1}}</span></button>{{end}}
{{else if eq $mode "yesno"}}<button class="hd-btn hd-respond ok" data-block="{{$id}}" data-value="yes">yes<span class="hd-hint">y</span></button><button class="hd-btn hd-respond err" data-block="{{$id}}" data-value="no">no<span class="hd-hint">n</span></button>
{{else}}<input class="hd-input ask-text-input" id="ask-input-{{$id}}" type="text" placeholder="hit Enter to start typing" data-placeholder-blur="hit Enter to start typing" data-placeholder-focus="Enter to submit · Esc to exit" /><button class="hd-btn hd-respond" data-block="{{$id}}" data-input="ask-input-{{$id}}">submit<span class="hd-hint">↵</span></button>{{end}}
</div>
{{- end}}
</div>
</section>
{{- end}}

{{define "block-decision" -}}
<section class="panel" data-vim-section id="{{.ID}}">
{{template "panel-head" .}}
{{with .Body.Prompt}}<div class="panel-body" style="padding-bottom:0"><div class="ask-prompt">{{md .}}</div></div>{{end}}
<div class="compare">
<div class="a"><h4><span class="tag">{{.Body.A.Tag}}</span> {{.Body.A.Title}}</h4><ul>{{range .Body.A.Items}}<li class="{{.Kind}}">{{.Text}}</li>{{end}}</ul></div>
<div class="b"><h4><span class="tag">{{.Body.B.Tag}}</span> {{.Body.B.Title}}</h4><ul>{{range .Body.B.Items}}<li class="{{.Kind}}">{{.Text}}</li>{{end}}</ul></div>
</div>
<div class="panel-body">
{{if .Answer -}}
<div class="ask-answered">▸ decided <b>{{.Answer.Value}}</b>{{with .Answer.At}} · {{.}}{{end}}</div>
{{- else -}}
<div class="ask-controls">
<button class="hd-btn hd-respond" data-block="{{.Body.ID}}" data-value="{{.Body.A.Tag}}">choose {{.Body.A.Tag}} · {{.Body.A.Title}}<span class="hd-hint">1</span></button>
<button class="hd-btn hd-respond" data-block="{{.Body.ID}}" data-value="{{.Body.B.Tag}}">choose {{.Body.B.Tag}} · {{.Body.B.Title}}<span class="hd-hint">2</span></button>
</div>
{{- end}}
</div>
</section>
{{- end}}

{{define "block-approval" -}}
<section class="panel" data-vim-section id="{{.ID}}">
{{template "panel-head" .}}
<div class="panel-body">
{{with .Body.Prompt}}<div class="ask-prompt">{{md .}}</div>{{end}}
{{if .Answer -}}
<div class="ask-answered">▸ <b>{{.Answer.Value}}</b>{{with .Answer.At}} · {{.}}{{end}}</div>
{{- else -}}
<div class="ask-controls">
<button class="hd-btn hd-respond ok" data-block="{{.Body.ID}}" data-value="approved">approve<span class="hd-hint">y</span></button>
<button class="hd-btn hd-respond err" data-block="{{.Body.ID}}" data-value="changes-requested">request changes<span class="hd-hint">n</span></button>
</div>
{{- end}}
</div>
</section>
{{- end}}

{{define "block-fallback" -}}
<section class="panel block-fallback" data-vim-section id="{{.ID}}">
<div class="panel-head"><span class="sigil" style="color:var(--tn-red)">!</span><span class="num">{{.Num}}</span> <span class="title-text">unrenderable block</span>
<div class="right"><span class="pill err">{{if .Body.Type}}{{.Body.Type}}{{else}}no type{{end}}</span></div>
</div>
<div class="panel-body">
<div class="callout err"><span class="tag">[BLOCK]</span> {{.Body.Reason}}</div>
<pre class="fallback-raw">{{.Body.Raw}}</pre>
</div>
</section>
{{- end}}
